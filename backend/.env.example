# ==============================================
# AI Teacher - Backend Environment Configuration
# Copy this file to .env and fill in your values
# ==============================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL with pgvector)
# You can use a full connection string (DATABASE_URL) OR individual connection parameters.
# Note: Supabase direct database connection (db.project-ref.supabase.co) is IPv6-only.
# If your network does not support IPv6, use the connection pooler URL instead:
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_teacher
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ai_teacher
DB_SSL=false
DB_POOL_MAX=20

# Authentication (JWT)
JWT_SECRET=your_jwt_super_secret_change_me_in_production
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# AI / LLM Services (Configure your preferred providers)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEFAULT_LLM_MODEL=gpt-4o

# Vector Embeddings & RAG
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Text-to-Speech (TTS) Services
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# AI Avatar & Video Generation
DID_API_KEY=your_did_api_key_here
HEYGEN_API_KEY=your_heygen_api_key_here

# Multilingual / Translation Services
TRANSLATION_PROVIDER=google
